# ==========================================
# APPLICATION
# ==========================================

APP_NAME=AgentVox
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1


# ==========================================
# SERVER
# ==========================================

HOST=0.0.0.0
PORT=8000


# ==========================================
# CORS
# ==========================================

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000


# ==========================================
# DATABASE
# ==========================================

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agentvox


# ==========================================
# JWT / SECURITY
# ==========================================

SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256


# ==========================================
# COOKIES
# ==========================================

COOKIE_HTTPONLY=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=


# ==========================================
# PATHS / LOGGING
# ==========================================

UPLOAD_DIR=uploads
LOG_DIR=logs
LOG_LEVEL=INFO


# ==========================================
# OPENAI
# ==========================================

LLM_ENABLED=false
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=


# ==========================================
# WEBSOCKET
# ==========================================

WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_HEARTBEAT_TIMEOUT_SECONDS=90


# ==========================================
# REDIS
# ==========================================

REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0